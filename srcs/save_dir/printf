#include <stdarg.h>
#include <unistd.h>
#include <stdbool.h>

#define FORMAT "cspdiuxX%"
#define FLAG "-+#0 "

enum	e_case
{
	lower,
	upper
};

int	*get_nb_printed(void)
{
	static int	nb;

	return (&nb);
}

int	ft_putchar(char	c)
{
	if (write(1, &c, 1) < 0)
		return (-1);
	*get_nb_printed() += 1;
	return (1);
}

int	ft_putstr(char *str)
{
	int	i;

	i = 0;
	if (!str)
		return (ft_putstr("(null)"));
	while (str && str[i])
	{
		if (ft_putchar(str[i]) < 0)
			return (-1);
		i++;
	}
	return (i);
}

int	ft_printnbr(unsigned long int nb, unsigned int base_len, char *base, int depth)
{
	if (nb >= base_len)
		ft_printnbr(nb / base_len, base_len, base, depth + 1);
	return (ft_putchar(base[nb % base_len]));
}

int	ft_puthexa(long long int nb, enum e_case casee)
{
	char	*base;

	base = (char *[]){"0123456789abcdef", "0123456789ABCDEF"}[casee];
	return (ft_printnbr(nb, 16, base, 0));
}

int	ft_putnbr(int nb)
{
	if (nb < 0)
		return (ft_putchar('-'), ft_printnbr(-1 * (long)nb, 10, "0123456789", 0));
	return (ft_printnbr(nb, 10, "0123456789", 0));
}

void	print_addr(unsigned long addr)
{
	if (!addr)
		return ((void)ft_putstr("(nil)"));
	ft_putstr("0x");
	ft_puthexa(addr, lower);
}

void	sc(char *str, va_list lst)
{
	if (*str == 's')
		ft_putstr(va_arg(lst, char *));
	else if (*str == 'c')
		ft_putchar(va_arg(lst, int));
	else if (*str == 'i' || *str == 'd')
		ft_putnbr(va_arg(lst, int));
	else if (*str == 'u')
		ft_printnbr(va_arg(lst, unsigned int), 10, "0123456789", 0);
	else if (*str == 'x')
		ft_puthexa(va_arg(lst, unsigned int), lower);
	else if (*str == 'X')
		ft_puthexa(va_arg(lst, unsigned int), upper);
	else if (*str == '%')
		ft_putchar('%');
	else if (*str == 'p')
		print_addr(va_arg(lst, unsigned long));
}

int	ft_printf(char *str, ...)
{
	va_list	lst;
	int	i;

	va_start(lst, str);
	i = 0;
	while (str && str[i])
	{
		if (str[i] == '%')
		{
			i++;
			sc(&str[i], lst);
		}
		else
			ft_putchar(str[i]);
		i++;
	}
	va_end(lst);
	return (*get_nb_printed());
}
